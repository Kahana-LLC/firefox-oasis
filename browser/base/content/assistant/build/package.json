{
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build:embedding-worker": "esbuild src/embedding-worker-entry.ts --bundle --platform=browser --format=iife --target=es2022 --outfile=../embedding-worker.bundle.js",
    "sync-embedding-assets": "node scripts/sync-embedding-assets.mjs",
    "test:reliability": "tsc -p tests/tsconfig.json && node --test tests/dist/build/tests/**/*.test.js",
    "test:voice-guards": "esbuild src/utils/voiceUtteranceGuards.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-voice-utterance-guards.mjs && esbuild src/utils/voiceVadDebounce.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-voice-vad-debounce.mjs && node --test tests/tmp-voice-utterance-guards.mjs tests/tmp-voice-vad-debounce.mjs",
    "test:explicit-routes": "esbuild tests/explicitRouteRules.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-explicit-route.mjs && node --test tests/tmp-explicit-route.mjs",
    "test:page-intent-routing": "esbuild tests/pageIntentRouting.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-page-intent-routing.mjs && node --test tests/tmp-page-intent-routing.mjs",
    "test:clarification-modal": "esbuild tests/clarificationModal.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-clarification-modal.mjs && node --test tests/tmp-clarification-modal.mjs",
    "test:capabilities-overview": "esbuild tests/capabilitiesOverview.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-capabilities-overview.mjs && node --test tests/tmp-capabilities-overview.mjs",
    "test:oauth-handoff": "esbuild tests/oauthHandoff.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-oauth-handoff.mjs && node --test tests/tmp-oauth-handoff.mjs",
    "test:page-content-extract": "esbuild tests/pageContentExtract.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-page-content-extract.mjs && node --test tests/tmp-page-content-extract.mjs",
    "test:research-brief": "esbuild tests/researchBrief.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-research-brief.mjs && node --test tests/tmp-research-brief.mjs",
    "test:research-brief-routing": "esbuild tests/researchBriefRouting.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-research-brief-routing.mjs && node --test tests/tmp-research-brief-routing.mjs",
    "test:research-brief-explicit": "esbuild tests/researchBriefExplicitResolver.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-research-brief-explicit.mjs && node --test tests/tmp-research-brief-explicit.mjs",
    "test:clarification-gate": "esbuild tests/clarificationGate.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-clarification-gate.mjs && node --test tests/tmp-clarification-gate.mjs",
    "test:research-brief-tabs": "esbuild tests/researchBriefTabResolve.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-research-brief-tabs.mjs && node --test tests/tmp-research-brief-tabs.mjs",
    "test:research-brief-topic": "esbuild tests/researchBriefTopic.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-research-brief-topic.mjs && node --test tests/tmp-research-brief-topic.mjs",
    "test:research-brief-scope": "esbuild tests/researchBriefScope.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-research-brief-scope.mjs && node --test tests/tmp-research-brief-scope.mjs",
    "test:research-brief-url-dedupe": "esbuild tests/researchBriefUrlDedupe.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-research-brief-url-dedupe.mjs && node --test tests/tmp-research-brief-url-dedupe.mjs",
    "test:research-brief-pre-test": "esbuild tests/researchBriefClarify.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-research-brief-clarify.mjs && esbuild tests/researchBriefSectionMerge.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-research-brief-section-merge.mjs && node --test tests/tmp-research-brief-clarify.mjs tests/tmp-research-brief-section-merge.mjs && npm run test:research-brief-explicit",
    "test:research-brief-utterances": "esbuild tests/researchBriefUtteranceMatrix.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-utterance-matrix.mjs && node --test tests/tmp-utterance-matrix.mjs && npm run test:research-brief-routing && npm run test:research-brief-explicit",
    "test:organize-tabs-utterances": "esbuild tests/organizeTabsUtteranceMatrix.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-organize-utterance-matrix.mjs && node --test tests/tmp-organize-utterance-matrix.mjs",
    "test:organize-tabs-routing": "esbuild tests/organizeTabsRouting.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-organize-routing.mjs && node --test tests/tmp-organize-routing.mjs",
    "test:organize-tabs-explicit": "esbuild tests/organizeTabsExplicitResolver.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-organize-explicit.mjs && node --test tests/tmp-organize-explicit.mjs",
    "test:organize-tabs-query": "esbuild tests/organizeTabsQuery.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-organize-query.mjs && node --test tests/tmp-organize-query.mjs",
    "test:organize-tabs-cluster": "esbuild tests/organizeTabsCluster.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-organize-cluster.mjs && node --test tests/tmp-organize-cluster.mjs",
    "test:organize-tabs": "npm run test:organize-tabs-query && npm run test:organize-tabs-explicit && npm run test:organize-tabs-routing && npm run test:organize-tabs-cluster && npm run test:organize-tabs-utterances",
    "test:search-history-query": "esbuild tests/historySearchQuery.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-search-history-query.mjs && node --test tests/tmp-search-history-query.mjs",
    "test:search-history-keyword": "esbuild tests/historyKeywordSearch.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-search-history-keyword.mjs && node --test tests/tmp-search-history-keyword.mjs",
    "test:search-history-routing": "esbuild tests/searchHistoryRouting.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-search-history-routing.mjs && node --test tests/tmp-search-history-routing.mjs",
    "test:search-history-refinement": "esbuild tests/historySearchRefinement.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-search-history-refinement.mjs && node --test tests/tmp-search-history-refinement.mjs",
    "test:prefer-deterministic-route": "esbuild tests/preferDeterministicRoute.test.ts --bundle --platform=node --packages=external --format=esm --outfile=tests/tmp-prefer-deterministic-route.mjs && node --test tests/tmp-prefer-deterministic-route.mjs",
    "test:search-history": "npm run test:search-history-query && npm run test:search-history-keyword && npm run test:search-history-routing && npm run test:search-history-refinement && npm run test:prefer-deterministic-route",
    "test:assist-usage": "esbuild tests/assistUsageMeta.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-assist-usage.mjs && node --test tests/tmp-assist-usage.mjs",
    "eval:agent-loop": "esbuild tests/agentLoopEval.test.ts --bundle --platform=node --format=esm --outfile=tests/tmp-agent-loop-eval.mjs && node --test tests/tmp-agent-loop-eval.mjs"
  },
  "devDependencies": {
    "dotenv": "^17.2.1",
    "esbuild": "^0.25.9",
    "typescript": "^5.5.4"
  },
  "dependencies": {
    "@aws-crypto/sha256-js": "^5.2.0",
    "@aws-sdk/client-s3": "^3.896.0",
    "@aws-sdk/credential-provider-cognito-identity": "^3.901.0",
    "@aws-sdk/protocol-http": "^3.370.0",
    "@aws-sdk/signature-v4": "^3.370.0",
    "@huggingface/transformers": "^3.4.0",
    "@langchain/core": "^0.3.72",
    "@orama/orama": "^3.1.0",
    "@supabase/supabase-js": "^2.45.4",
    "idb": "^8.0.3",
    "minisearch": "^7.2.0",
    "railroad-memory": "^0.2.1",
    "zod": "^3.25.76"
  }
}
